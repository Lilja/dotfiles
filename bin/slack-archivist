#!/usr/bin/env python3
"""Archive a Slack thread to disk: avatars, emoji, Markdown and HTML.

Driven by the /slack-archivist Claude skill, which reads the thread via the
Slack MCP and writes thread.json. This script does the deterministic parts:

  slack-archivist parse-url <permalink>
      -> JSON {channel_id, thread_ts, message_ts, workspace}

  slack-archivist dir <channel_id> <thread_ts> <first message text> [--name-hint NAME]
      -> prints the thread directory (existing one for this thread_ts, or a new one)

  slack-archivist render <thread_dir>
      -> enriches thread.json (user names, avatars, channel name), downloads
         avatars/custom emoji into _assets, writes thread.md and thread.html

Avatars and custom emoji are normally collected beforehand by
`slack-archivist-browser scrape` into _assets; render uses whatever is there.
Optionally, if a Slack app with users:read/emoji:read/channels:read is installed
(manifest in ~/dotfiles/slack/archivist-app), set SLACK_ARCHIVIST_APP to its app
ID/environment and lookups also go through `slack api` with its bot token.
"""

import argparse
import datetime as dt
import html
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(os.environ.get("SLACK_ARCHIVIST_ROOT", "~/Documents/funnel/archivist")).expanduser()
ASSETS = ROOT / "_assets"
APP_DIR = Path(os.environ.get("SLACK_ARCHIVIST_APP_DIR", Path(__file__).resolve().parent.parent / "slack" / "archivist-app"))
APP = os.environ.get("SLACK_ARCHIVIST_APP")  # unset = no Slack app; images come from slack-archivist-browser
TEAM = os.environ.get("SLACK_ARCHIVIST_TEAM", "T028ZCH60")
EMOJI_DATA_URL = "https://raw.githubusercontent.com/iamcal/emoji-data/master/emoji.json"


def die(msg):
    print(f"slack-archivist: {msg}", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------- slack api

class NoApp(RuntimeError):
    pass


def warn(what, e):
    if not isinstance(e, NoApp):
        print(f"slack-archivist: {what} ({e})", file=sys.stderr)


def slack_api(method, **params):
    if not APP:
        raise NoApp("SLACK_ARCHIVIST_APP not set")
    args = ["slack", "api", method, "--app", APP, "--team", TEAM, "--skip-update"]
    args += [f"{k}={v}" for k, v in params.items()]
    proc = subprocess.run(args, cwd=APP_DIR, capture_output=True, text=True)
    out = proc.stdout.strip()
    start = out.find("{")
    if start < 0:
        raise RuntimeError(f"{method}: no JSON in output: {out or proc.stderr.strip()}")
    data = json.loads(out[start:])
    if not data.get("ok"):
        raise RuntimeError(f"{method}: {data.get('error')}")
    return data


def download(url, dest):
    dest.parent.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": "slack-archivist"})
    with urllib.request.urlopen(req, timeout=30) as r:
        tmp = dest.with_suffix(dest.suffix + ".part")
        tmp.write_bytes(r.read())
        tmp.replace(dest)


def glob_escape(s):
    return re.sub(r"([*?\[])", r"[\1]", s)


def ext_of(url, default=".png"):
    suffix = Path(urllib.parse.urlparse(url).path).suffix.lower()
    return suffix if suffix in {".png", ".jpg", ".jpeg", ".gif", ".webp"} else default


# ---------------------------------------------------------------- parse-url

def parse_url(url):
    u = urllib.parse.urlparse(url)
    m = re.match(r"/archives/([A-Z0-9]+)/p(\d{10})(\d{6})", u.path)
    if not m:
        die(f"not a Slack message permalink: {url}")
    channel, secs, micros = m.groups()
    message_ts = f"{secs}.{micros}"
    q = urllib.parse.parse_qs(u.query)
    thread_ts = q.get("thread_ts", [message_ts])[0]
    return {
        "workspace": u.hostname.split(".")[0] if u.hostname else None,
        "channel_id": q.get("cid", [channel])[0],
        "message_ts": message_ts,
        "thread_ts": thread_ts,
    }


# ---------------------------------------------------------------- dir

def slugify(text, limit=50):
    text = re.sub(r"<[^>|]*\|([^>]*)>", r"\1", text)  # <url|label> -> label
    text = re.sub(r"<[^>]*>|:[a-z0-9_+'-]+:", " ", text.lower())
    slug = re.sub(r"[^a-z0-9]+", "-", text).strip("-")
    return (slug[:limit].rstrip("-")) or "thread"


def channel_name(channel_id, hint=None):
    try:
        info = slack_api("conversations.info", channel=channel_id)["channel"]
        if info.get("is_im"):
            return hint or f"dm-{channel_id}"
        return info.get("name") or hint or channel_id
    except Exception as e:  # private channel / DM the bot can't see
        warn("conversations.info failed; using hint", e)
        return hint or channel_id


def find_existing(thread_ts):
    for tj in ROOT.glob("*/*/thread.json"):
        try:
            if json.loads(tj.read_text()).get("thread_ts") == thread_ts:
                return tj.parent
        except (OSError, json.JSONDecodeError):
            continue
    return None


def cmd_dir(a):
    existing = find_existing(a.thread_ts)
    if existing:
        print(existing)
        return
    name = re.sub(r"[^a-zA-Z0-9_.-]+", "-", channel_name(a.channel_id, a.name_hint)).strip("-")
    date = dt.datetime.fromtimestamp(float(a.thread_ts)).strftime("%Y-%m-%d")
    d = ROOT / name / f"{date}_{slugify(a.first_text)}"
    if d.exists():  # same slug & date, different thread
        d = d.with_name(f"{d.name}-{a.thread_ts.replace('.', '')[-6:]}")
    (d / "files").mkdir(parents=True, exist_ok=True)
    print(d)


# ---------------------------------------------------------------- emoji

class Emoji:
    """Resolves emoji names to a local image (custom) or a unicode char."""

    def __init__(self):
        self.custom = self._load_custom()
        self.unicode = self._load_unicode()

    def _load_custom(self):
        cache = ASSETS / "emoji-list.json"
        try:
            data = slack_api("emoji.list")["emoji"]
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps(data))
            return data
        except Exception as e:
            warn("emoji.list failed; using cache", e)
            return json.loads(cache.read_text()) if cache.exists() else {}

    def _load_unicode(self):
        cache = ASSETS / "emoji-data.json"
        if not cache.exists():
            try:
                download(EMOJI_DATA_URL, cache)
            except Exception as e:
                print(f"slack-archivist: emoji-data download failed ({e})", file=sys.stderr)
                return {}
        table = {}
        for e in json.loads(cache.read_text()):
            char = "".join(chr(int(c, 16)) for c in e["unified"].split("-"))
            for n in e["short_names"]:
                table[n] = char
            for tone, var in (e.get("skin_variations") or {}).items():
                tchar = "".join(chr(int(c, 16)) for c in var["unified"].split("-"))
                idx = {"1F3FB": 2, "1F3FC": 3, "1F3FD": 4, "1F3FE": 5, "1F3FF": 6}.get(tone)
                if idx:
                    for n in e["short_names"]:
                        table[f"{n}::skin-tone-{idx}"] = tchar
        return table

    def resolve(self, name, seen=None):
        """-> ("img", relpath-from-ROOT) | ("char", "👍") | ("text", ":name:")"""
        seen = seen or set()
        if name in self.unicode:
            return "char", self.unicode[name]
        local = [p for p in sorted((ASSETS / "emoji").glob(f"{glob_escape(name)}.*")) if not p.name.endswith(".part")]
        if local:  # saved earlier, e.g. by slack-archivist-browser
            return "img", local[0].relative_to(ROOT).as_posix()
        url = self.custom.get(name)
        if url and url.startswith("alias:") and name not in seen:
            seen.add(name)
            return self.resolve(url[len("alias:"):], seen)
        if url:
            dest = ASSETS / "emoji" / f"{name}{ext_of(url)}"
            if not dest.exists():
                try:
                    download(url, dest)
                except Exception as e:
                    print(f"slack-archivist: emoji {name} download failed ({e})", file=sys.stderr)
                    return "text", f":{name}:"
            return "img", dest.relative_to(ROOT).as_posix()
        base = name.split("::")[0]
        if base != name:
            return self.resolve(base, seen)
        return "text", f":{name}:"


# ---------------------------------------------------------------- people

def existing_avatar(key):
    found = sorted((ASSETS / "avatars").glob(f"{key}.*"))
    found = [p for p in found if not p.name.endswith(".part")]
    return found[0] if found else None


def lookup_person(uid=None, bot_id=None):
    key = uid or bot_id
    person = {"id": key, "name": None, "avatar": None, "is_bot": bool(bot_id and not uid)}
    url = None
    try:
        if uid:
            u = slack_api("users.info", user=uid)["user"]
            p = u.get("profile", {})
            person["name"] = p.get("display_name") or p.get("real_name") or u.get("name")
            person["real_name"] = p.get("real_name")
            person["is_bot"] = u.get("is_bot", False)
            url = p.get("image_512") or p.get("image_192") or p.get("image_72")
        else:
            b = slack_api("bots.info", bot=bot_id)["bot"]
            person["name"] = b.get("name")
            icons = b.get("icons", {})
            url = icons.get("image_72") or icons.get("image_48") or icons.get("image_36")
    except Exception as e:
        warn(f"lookup {key} failed", e)
    avatar = existing_avatar(key)  # keep the first avatar we ever saved
    if not avatar and url:
        avatar = ASSETS / "avatars" / f"{key}{ext_of(url, '.jpg')}"
        try:
            download(url, avatar)
        except Exception as e:
            print(f"slack-archivist: avatar {key} download failed ({e})", file=sys.stderr)
            avatar = None
    if avatar:
        person["avatar"] = avatar.relative_to(ROOT).as_posix()
    return person


# ---------------------------------------------------------------- text

def initials(name):
    parts = [p for p in re.split(r"\s+", name or "?") if p]
    return "".join(p[0] for p in parts[:2]).upper() or "?"


def fmt_time(ts):
    return dt.datetime.fromtimestamp(float(ts)).strftime("%Y-%m-%d %H:%M")


def render_text_html(text, people, emoji, rel):
    """Minimal Slack mrkdwn -> HTML. `rel` is the path prefix from thread dir to ROOT."""
    code_blocks = []

    def stash_block(m):
        code_blocks.append(m.group(1))
        return f"\x00{len(code_blocks) - 1}\x00"

    text = re.sub(r"```(.*?)```", stash_block, text, flags=re.S)
    out = html.escape(text, quote=False)

    def link(m):
        target, _, label = m.group(1).partition("|")
        if target.startswith("@"):
            uid = target[1:]
            name = label or (people.get(uid) or {}).get("name") or uid
            return f'<span class="mention">@{html.escape(name)}</span>'
        if target.startswith("#"):
            return f'<span class="mention">#{html.escape(label or target[1:])}</span>'
        if target.startswith("!"):
            return f'<span class="mention">@{html.escape(label or target[1:].split("^")[0])}</span>'
        return f'<a href="{html.escape(target)}">{label or html.escape(target)}</a>'

    out = re.sub(r"&lt;([^&]*?)&gt;", link, out)

    def emo(m):
        kind, val = emoji.resolve(m.group(1))
        if kind == "img":
            return f'<img class="emoji" src="{rel}{val}" alt=":{m.group(1)}:" title=":{m.group(1)}:">'
        return html.escape(val)

    out = re.sub(r":([a-z0-9_+'-]+(?:::skin-tone-\d)?):", emo, out)
    out = re.sub(r"`([^`\n]+)`", r"<code>\1</code>", out)
    out = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])", r"<b>\1</b>", out)
    out = re.sub(r"(?<![\w_])_([^_\n]+)_(?![\w_])", r"<i>\1</i>", out)
    out = re.sub(r"(?<![\w~])~([^~\n]+)~(?![\w~])", r"<s>\1</s>", out)
    out = re.sub(r"^&gt; ?(.*)$", r"<blockquote>\1</blockquote>", out, flags=re.M)
    out = out.replace("\n", "<br>")
    return re.sub(r"\x00(\d+)\x00", lambda m: f"<pre>{html.escape(code_blocks[int(m.group(1))])}</pre>", out)


def render_text_md(text, people, emoji):
    def link(m):
        target, _, label = m.group(1).partition("|")
        if target.startswith("@"):
            return "@" + (label or (people.get(target[1:]) or {}).get("name") or target[1:])
        if target.startswith(("#", "!")):
            return ("#" if target[0] == "#" else "@") + (label or target[1:])
        return f"[{label}]({target})" if label else target

    text = re.sub(r"<([^>]*)>", link, text)

    def emo(m):
        kind, val = emoji.resolve(m.group(1))
        return val if kind != "img" else m.group(0)

    return re.sub(r":([a-z0-9_+'-]+(?:::skin-tone-\d)?):", emo, text)


# ---------------------------------------------------------------- render

CSS = """
body{font:15px/1.46 -apple-system,BlinkMacSystemFont,"Segoe UI",Lato,sans-serif;color:#1d1c1d;max-width:860px;margin:2em auto;padding:0 1em}
header{border-bottom:1px solid #ddd;margin-bottom:1em;padding-bottom:.5em}
header h1{font-size:18px;margin:0}header a,header span{color:#616061;font-size:13px}
.msg{display:flex;gap:10px;padding:8px 0}.msg.reply{margin-left:24px}
.avatar{width:36px;height:36px;border-radius:6px;flex:none;object-fit:cover}
.initials{display:flex;align-items:center;justify-content:center;background:#4a154b;color:#fff;font-weight:700;font-size:13px}
.name{font-weight:900}.time{color:#616061;font-size:12px;margin-left:6px}
.emoji{width:22px;height:22px;vertical-align:middle}
.mention{background:#e8f5fa;color:#1264a3;border-radius:3px;padding:0 2px}
code{background:#f6f6f6;border:1px solid #ddd;border-radius:3px;padding:0 3px;color:#c01343;font-size:12px}
pre{background:#f6f6f6;border:1px solid #ddd;border-radius:4px;padding:8px;white-space:pre-wrap;font-size:12px}
blockquote{border-left:4px solid #ddd;margin:0;padding-left:10px}
.reactions{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
.reaction{border:1px solid #ddd;border-radius:12px;padding:1px 8px;font-size:12px;background:#f8f8f8;display:flex;align-items:center;gap:4px}
.reaction .emoji{width:16px;height:16px}
.files img{max-width:480px;max-height:360px;border-radius:6px;border:1px solid #ddd;margin-top:6px;display:block}
.file{display:inline-block;border:1px solid #ddd;border-radius:6px;padding:6px 10px;margin-top:6px;font-size:13px}
.divider{color:#616061;font-size:13px;border-top:1px solid #eee;margin:8px 0;padding-top:4px}
"""


def html_avatar(person, rel):
    if person.get("avatar"):
        return f'<img class="avatar" src="{rel}{person["avatar"]}" alt="">'
    return f'<div class="avatar initials">{html.escape(initials(person.get("name")))}</div>'


def html_emoji(name, emoji, rel):
    kind, val = emoji.resolve(name)
    if kind == "img":
        return f'<img class="emoji" src="{rel}{val}" alt=":{name}:">'
    return html.escape(val)


def render_html(t, people, emoji, rel):
    ch = t["channel"].get("name") or t["channel"]["id"]
    parts = [
        "<!doctype html><meta charset=utf-8>",
        f"<title>#{html.escape(ch)} — {html.escape(t.get('title', ''))}</title><style>{CSS}</style>",
        f'<header><h1>#{html.escape(ch)}</h1><a href="{html.escape(t.get("permalink", ""))}">Open in Slack</a> '
        f'<span>· archived {html.escape(t.get("archived_at", ""))} · {len(t["messages"])} messages</span></header>',
    ]
    for i, m in enumerate(t["messages"]):
        who = people.get(m.get("user_id") or m.get("bot_id")) or {"name": m.get("user_name")}
        name = who.get("name") or m.get("user_name") or "unknown"
        if i == 1:
            parts.append(f'<div class="divider">{len(t["messages"]) - 1} replies</div>')
        body = render_text_html(m.get("text", ""), people, emoji, rel)
        files = []
        for f in m.get("files", []):
            label = html.escape(f.get("name") or f.get("id", "file"))
            if f.get("local_path") and (f.get("mimetype") or "").startswith("image/"):
                files.append(f'<a href="{html.escape(f["local_path"])}"><img src="{html.escape(f["local_path"])}" alt="{label}"></a>')
            elif f.get("local_path"):
                files.append(f'<a class="file" href="{html.escape(f["local_path"])}">📎 {label}</a>')
            else:
                href = html.escape(f.get("permalink") or "#")
                files.append(f'<a class="file" href="{href}">📎 {label} (not downloaded)</a>')
        reacts = []
        for r in m.get("reactions", []):
            users = ", ".join((people.get(u) or {}).get("name") or u for u in r.get("users", []))
            reacts.append(
                f'<span class="reaction" title=":{html.escape(r["name"])}: by {html.escape(users)}">'
                f'{html_emoji(r["name"], emoji, rel)} {r.get("count", len(r.get("users", [])))}</span>'
            )
        edited = ' <span class="time">(edited)</span>' if m.get("edited") else ""
        parts.append(
            f'<div class="msg{" reply" if i else ""}">{html_avatar(who, rel)}<div>'
            f'<span class="name">{html.escape(name)}</span><span class="time">{fmt_time(m["ts"])}</span>{edited}'
            f'<div class="text">{body}</div>'
            + (f'<div class="files">{"".join(files)}</div>' if files else "")
            + (f'<div class="reactions">{"".join(reacts)}</div>' if reacts else "")
            + "</div></div>"
        )
    return "\n".join(parts) + "\n"


def render_md(t, people, emoji, rel):
    ch = t["channel"].get("name") or t["channel"]["id"]
    lines = [f"# #{ch} — {t.get('title', '')}", "", f"[Open in Slack]({t.get('permalink', '')}) · archived {t.get('archived_at', '')}", ""]
    for i, m in enumerate(t["messages"]):
        who = people.get(m.get("user_id") or m.get("bot_id")) or {}
        name = who.get("name") or m.get("user_name") or "unknown"
        if i == 1:
            lines += ["---", ""]
        avatar = f'<img src="{rel}{who["avatar"]}" width="20" height="20"> ' if who.get("avatar") else ""
        lines.append(f"### {avatar}{name} · {fmt_time(m['ts'])}{' (edited)' if m.get('edited') else ''}")
        lines.append("")
        if m.get("text"):
            lines += [render_text_md(m["text"], people, emoji), ""]
        for f in m.get("files", []):
            label = f.get("name") or f.get("id")
            if f.get("local_path") and (f.get("mimetype") or "").startswith("image/"):
                lines.append(f"![{label}]({f['local_path']})")
            elif f.get("local_path"):
                lines.append(f"📎 [{label}]({f['local_path']})")
            else:
                lines.append(f"📎 [{label}]({f.get('permalink', '')}) (not downloaded)")
        if m.get("reactions"):
            rs = []
            for r in m["reactions"]:
                kind, val = emoji.resolve(r["name"])
                shown = val if kind == "char" else f':{r["name"]}:'
                users = ", ".join((people.get(u) or {}).get("name") or u for u in r.get("users", []))
                rs.append(f"{shown} {r.get('count', len(r.get('users', [])))}" + (f" ({users})" if users else ""))
            lines += ["", "Reactions: " + " · ".join(rs)]
        lines.append("")
    return "\n".join(lines)


def cmd_render(a):
    d = Path(a.thread_dir).expanduser().resolve()
    tj = d / "thread.json"
    if not tj.exists():
        die(f"{tj} not found")
    t = json.loads(tj.read_text())
    rel = os.path.relpath(ROOT, d) + "/"

    if not t["channel"].get("name") or a.refresh_channel:
        name = channel_name(t["channel"]["id"], t["channel"].get("name"))
        # Don't persist the ID as a name, or a later render would never look it up again.
        t["channel"]["name"] = None if name == t["channel"]["id"] else name

    ids = {}
    for m in t["messages"]:
        if m.get("user_id") or m.get("bot_id"):
            ids[m.get("user_id") or m.get("bot_id")] = (m.get("user_id"), m.get("bot_id"))
        for r in m.get("reactions", []):
            for u in r.get("users", []):
                ids.setdefault(u, (u, None))
        for uid in re.findall(r"<@([UW][A-Z0-9]+)", m.get("text", "")):
            ids.setdefault(uid, (uid, None))

    people = {k: lookup_person(uid, bot) for k, (uid, bot) in ids.items()}
    # Fall back to names the MCP gave us when the API lookup failed.
    known = dict(t.get("known_names") or {})
    for m in t["messages"]:
        key = m.get("user_id") or m.get("bot_id")
        if key and m.get("user_name"):
            known.setdefault(key, m["user_name"])
    for k, p in people.items():
        if not p.get("name"):
            p["name"] = known.get(k)
    t["people"] = people

    emoji = Emoji()
    names = {r["name"] for m in t["messages"] for r in m.get("reactions", [])}
    for m in t["messages"]:
        names |= set(re.findall(r":([a-z0-9_+'-]+(?:::skin-tone-\d)?):", m.get("text", "")))
    t["emoji"] = {n: dict(zip(("kind", "value"), emoji.resolve(n))) for n in sorted(names)}

    tj.write_text(json.dumps(t, indent=2, ensure_ascii=False) + "\n")
    (d / "thread.md").write_text(render_md(t, people, emoji, rel))
    (d / "thread.html").write_text(render_html(t, people, emoji, rel))
    missing_av = sorted(k for k, p in people.items() if not p.get("avatar"))
    missing_em = sorted(n for n, e in t["emoji"].items() if e["kind"] == "text")
    print(json.dumps({
        "dir": str(d),
        "html": str(d / "thread.html"),
        "messages": len(t["messages"]),
        "people": len(people),
        "missing_avatars": missing_av,
        "unresolved_emoji": missing_em,
    }, indent=2))


def main():
    ap = argparse.ArgumentParser(prog="slack-archivist", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("parse-url")
    p.add_argument("url")
    p = sub.add_parser("dir")
    p.add_argument("channel_id")
    p.add_argument("thread_ts")
    p.add_argument("first_text")
    p.add_argument("--name-hint")
    p = sub.add_parser("render")
    p.add_argument("thread_dir")
    p.add_argument("--refresh-channel", action="store_true")
    a = ap.parse_args()
    if a.cmd == "parse-url":
        print(json.dumps(parse_url(a.url)))
    elif a.cmd == "dir":
        cmd_dir(a)
    else:
        cmd_render(a)


if __name__ == "__main__":
    main()
